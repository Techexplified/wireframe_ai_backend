# Wireframe AI — Firebase Functions environment variables example template
# Copy to .env and fill in real credentials

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB=wireframe_ai

# ── Dodo Payments ─────────────────────────────────────────────────────────────
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# ── Dodo Product IDs ──────────────────────────────────────────────────────────
DODO_PRODUCT_PRO=
DODO_PRODUCT_TOPUP_SMALL=
DODO_PRODUCT_TOPUP_MEDIUM=
DODO_PRODUCT_TOPUP_LARGE=

# ── App base URL ──────────────────────────────────────────────────────────────
APP_BASE_URL=https://us-central1-wireframe-ai-8079f.cloudfunctions.net/api

# ── Plan config ───────────────────────────────────────────────────────────────
FREE_TRIAL_CREDITS=3

# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
